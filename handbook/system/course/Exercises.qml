import QtQuick
import VisionCraft
Section {
    title: qsTr("综合练习：解释选择、结果与失败")
    lead: qsTr("先不改代码，写出预测与理由；再沿指定示例观察。答案不以新增按钮数量评分，而看是否说清数据含义、适用条件和状态归属。")
    KeyPoints {
        label: qsTr("先修路线")

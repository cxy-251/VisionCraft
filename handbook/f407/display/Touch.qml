import QtQuick
import VisionCraft

Section {
    title: qsTr("GT9147 电容触摸")
    lead: qsTr("4.3 寸屏上的电容触摸是一颗独立的芯片，经 I2C 告诉主控「有几个手指、各在哪」。这块屏上实际装的是同系列的 GT917S；读之前先按时序复位它，否则它什么也不报告。")

    Why {
        text: qsTr("工位屏想做成能直接操作的终端（下一节「触屏终端与软键盘」），第一步是拿到准确的触摸坐标。"
                 + "触摸芯片和屏幕显示是两套东西：显示走 FSMC，触摸走单独的 I2C（PB0 时钟、PF11 数据，另有 PB1 中断、PC13 复位）。工位固件目前不管触摸。"
                 + "本节用调试器直接「摇」这几个 GPIO 模拟 I2C 去读芯片，实际按屏的操作由本手册的使用者在板子旁边完成。")
    }

    CodeRef { file: "tools/gt9147_probe.tcl"; region: "bitbang" }

    KeyPoints {
        label: qsTr("用调试器模拟 I2C")
        points: [
            qsTr("I2C 的两根线都是「开漏」的：谁都只能把线拉低，放开时由上拉电阻拉高。这里输出 0 就把引脚设成输出低电平，输出 1 就把引脚改成输入、让上拉电阻把线拉高。连接前读到两根线空闲时都是高电平，说明模块上有上拉。"),
            qsTr("每放开一次 SCL，都要等它真的变高再继续：从机忙时可以拉住时钟（时钟延展）。"),
            qsTr("经调试器每改一次引脚要零点几毫秒，读一个寄存器要几十次改动，所以这样读得很慢：读一次状态加一个点的坐标，大约要 0.9 秒。这只适合摸清芯片怎么工作，不能当真正的驱动。")
        ]
    }

    CodeRef { file: "tools/gt9147_probe.tcl"; region: "regs" }
    CodeRef { file: "handbook/f407/display/touch-probe.txt"; from: "==== 1"; to: "一直是 0"; caption: qsTr("第一次读：认出了芯片，却读不到触摸") }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("器件在 I2C 地址 0x14 应答，0x5D 没有。汇顶的这类芯片在复位松开的那一刻看 INT 脚的电平，在两个地址里选一个。"),
            qsTr("产品 ID 读到「917S」（原始字节 39 31 37 53 00），不是目录标题里的 9147：这块屏装的是 GT917S。它和 GT9147 读触摸点的寄存器相同（下面的实测证明了这一点），但别的寄存器（比如 0x8146 起的内容）不能照 GT9147 的定义去读，本节不去解读。"),
            qsTr("命令寄存器 0x8040 读到 0xFF。之后连续读了 90 秒、40 秒，期间用手指按、滑，状态寄存器始终没有报告触摸。")
        ]
    }

    CodeRef { file: "tools/gt9147_probe.tcl"; region: "reset" }
    CodeRef { file: "handbook/f407/display/touch-probe.txt"; from: "==== 2"; to: "==== 3"; caption: qsTr("复位之后") }

    Pitfall {
        text: qsTr("触摸芯片上电后要由主控按规定的时序复位一次：RST 拉低，INT 给定电平（决定地址），松开 RST，INT 改回输入；然后往 0x8040 写 2 做软件复位，再写 0 让它开始工作。"
                 + "工位固件从来没做过这些，芯片就停在一个「能应答、能读 ID、却不扫描」的状态（0x8040 = 0xFF）。按时序复位之后 0x8040 变成 0，马上就能读到坐标了。"
                 + "「能读到 ID」只说明 I2C 通了，不说明芯片在正常工作——这和「FSMC 时序与屏幕识别」里读屏幕 ID 是同一个道理。")
    }

    CodeRef { file: "tools/gt9147_probe.tcl"; region: "poll" }
    CodeRef { file: "handbook/f407/display/touch-probe.txt"; from: "==== 3"; caption: qsTr("按一个角、两次滑动、双指") }

    KeyPoints {
        label: qsTr("坐标")
        points: [
            qsTr("坐标是竖屏 480 × 800 的方向：屏幕上「VISIONCRAFT」标题那一头 y 接近 0，四个角分别读到 (44,37)、(436,36)、(46,761)、(416,762)。手指按不到最边缘，所以离 0、480、800 都差几十。"),
            qsTr("工位界面是横着画的（标题沿长边），而触摸坐标是竖屏方向，做触摸界面时要和显示用同一套坐标换算。"),
            qsTr("从标题那头往下滑：y 从 19 一路增加到 735，x 在 57–107 之间变化，和手指的实际轨迹一致。"),
            qsTr("两个手指同时按：状态寄存器低 4 位是 2，两个点 (277,281)、(170,425) 分别在 0x8150、0x8158 起的两组寄存器里。"),
            qsTr("每读完一次要往 0x814E 写 0，芯片才会放进下一帧数据。")
        ]
    }

    Try {
        task: qsTr("如果复位时让 INT 脚输出低电平而不是高电平，芯片会在哪个地址应答？")
        answerNote: qsTr("按汇顶芯片的规则，复位松开时 INT 为低选 0x5D（写地址 0xBA），为高选 0x14（0x28）。本节只做了 INT 为高的情况，0x5D 那种没有实测；没复位前芯片也是在 0x14 应答，说明它上电时 INT 恰好处在选 0x14 的电平。")
    }

    InSystem {
        text: qsTr("要让工位固件支持触摸：在 station.ioc 里把 PB0、PF11 配成开漏输出（或用硬件 I2C，需看引脚是否支持）、PB1 作中断输入、PC13 作输出，固件启动时做本节的复位序列，之后在中断里或定时读 0x814E 和坐标，交给界面任务。下一节就是基于这个。")
    }
}

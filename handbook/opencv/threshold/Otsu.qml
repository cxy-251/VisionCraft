import QtQuick
import VisionCraft

Section {
    title: qsTr("全局阈值与 OTSU")
    lead: qsTr("把图像分成「前景」和「背景」两类像素，是大多数检测的第一步。阈值选多少，大津法能替你算。")

    Why {
        text: qsTr("工位上的垫圈是亮的金属，传送带是暗的。只要找一个亮度值，比它亮的算工件、比它暗的算背景，"
                 + "就得到一张黑白图（二值图），后面才能找轮廓、量尺寸。这个亮度值就是阈值。手动定阈值的问题是："
                 + "换一批工件、灯光稍微变一下，合适的值就变了。大津法（OTSU）根据每张图自己的灰度分布自动算阈值。")
    }

    Demo {
        title: qsTr("拖动阈值，看分割结果和直方图")
        ThresholdView { }
        Para {
            font.pixelSize: Theme.fontSmall
            color: Theme.textMuted
            text: qsTr("直方图横轴是亮度 0~255，纵轴是这个亮度的像素有多少。左边一大簇是传送带，右边一簇是金属。"
                     + "青线是你选的阈值，绿线是大津法算的。试试把「光照不均」拉到 100%，再按「用大津法的值」。")
        }
    }

    Para { text: qsTr("在 OpenCV 里，阈值化是一行代码：") }
    CodeRef { file: "src/demos/opencv/ThresholdDemo.cpp"; region: "threshold" }

    Para {
        text: qsTr("大津法的思路：把直方图在某个亮度处切成两半，算两类像素各自的方差；"
                 + "逐个试 0~255，取「两类内部方差之和最小」（等价于「两类之间差别最大」）的那个切点。"
                 + "所以它最适合直方图有两个明显山峰的情况。用法是在类型里加上 THRESH_OTSU，传入的阈值参数被忽略，返回值就是算出来的阈值：")
    }
    CodeRef { file: "src/demos/opencv/ThresholdDemo.cpp"; region: "otsu" }

    Para { text: qsTr("工位的检测算法第一步就是它，只是先做了一次高斯模糊，让直方图的两个峰更干净：") }
    CodeRef { file: "src/vision/Inspector.cpp"; region: "segment" }

    KeyPoints {
        label: qsTr("光照不均时会怎样（测试 tst_threshold_demo 实测）")
        points: [
            qsTr("模拟方法：左边加一片眩光（整体加亮），右边逐渐变暗（整体乘一个系数），程度从 0% 到 100%。以均匀光照下的分割结果为准，统计分错的像素。"),
            qsTr("0%~75%：大津阈值在 128~141 之间移动，分错的像素不超过 0.4%。全局阈值相当耐用。"),
            qsTr("100%：大津阈值跳到 111，分错 31.8% 的像素。这时左边被眩光照亮的传送带，已经比右边暗处的金属还亮——不存在任何一个全局阈值能把它们分开。"),
            qsTr("有意思的是，只让整幅图变暗（不加眩光）时，前景和背景同比例变暗，大津法几乎不受影响：问题不在「暗」，而在「同一亮度在不同位置含义不同」。")
        ]
    }

    Pitfall {
        text: qsTr("THRESH_OTSU 只接受单通道的 8 位或 16 位图像（本机 OpenCV 4.12 实测：CV_8UC3、CV_32FC1 都会抛异常）。"
                 + "彩色图要先 cvtColor 转灰度，浮点图要先转换类型。")
    }

    Pitfall {
        text: qsTr("大津法假设直方图有两个峰。如果目标很小（比如占画面 1% 的一个小零件），它在直方图上几乎没有存在感，"
                 + "算出的阈值会偏向把背景内部再分成两类。这时可以只在感兴趣的区域里算，或者改用其他方法。")
    }

    Pitfall {
        text: qsTr("光照不均靠调阈值解决不了，上面 100% 的情况就是例子。办法有两类：改善照明（工业现场最常用，加漫射光源、遮光罩），"
                 + "或者用自适应阈值——每个像素和它周围一小块区域比，而不是和全图比（下一节）。")
    }

    Try {
        task: qsTr("在演示里把「光照不均」从 75% 慢慢拉到 100%，盯着直方图看：大津法的阈值为什么会突然从 140 附近跳到 110 附近？两个峰发生了什么？")
        answerNote: qsTr("眩光把左侧传送带的亮度抬到一百多，暗处的金属降到一百多，两个峰在中间连成了一片。"
                       + "大津法找的是「两类方差之和最小」的切点，峰合并后最优切点换了地方，于是突然跳变。"
                       + "这也说明大津法给出的阈值本身可以当作诊断信号：生产中如果它突然大幅变化，很可能是照明出了问题。")
    }

    InSystem {
        text: qsTr("工位检测算法 src/vision/Inspector.cpp 的第一步就是模糊 + 大津法分割；检测结果里的 otsu 测量值就是每张图算出的阈值。")
    }
}

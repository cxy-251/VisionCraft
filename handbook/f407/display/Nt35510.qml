import QtQuick
import VisionCraft

Section {
    title: qsTr("NT35510 排查实录")
    lead: qsTr("屏幕不亮、不对，问题可能出在三层：总线（FSMC 能不能和屏说话）、显存（像素数据写进去没有）、显示输出（屏把显存变成光，背光亮不亮）。调试器能读回前两层，第三层只能靠眼睛。本节是一次真实的排查：要验证的说法是「NT35510 不写厂家的初始化表就白屏」。")

    Why {
        text: qsTr("固件 App/lcd.c 的 lcd_init 给屏写了一长串厂家参数（电源、伽马表），旧版固件留下来的说法是：不写这张表，屏幕一片白。手册的「FSMC 与 8080 并口」一节早先照抄了这句话。"
                 + "这次用调试器动手验证：不写那张表，只做最少的几步，看屏上到底是什么。调试器负责发命令、读回显存，屏上的样子由本手册的使用者在板子旁边看。")
    }

    CodeRef { file: "tools/nt35510_minimal.tcl"; region: "minimal" }
    CodeRef { file: "handbook/f407/display/nt35510-test.txt"; from: "==== 1"; to: "==== 2"; caption: qsTr("第 1 次：软件复位后只做最少几步") }

    Para {
        text: qsTr("CPU 暂停（固件不会同时画屏），给屏发软件复位 0x0100，再退出睡眠、设成 16 位色、开显示，整屏填红。显存读回 0xF800，屏上是正常的红色。"
                 + "这个结果还不够：软件复位不一定把屏的所有状态都恢复成上电时的样子，也许厂家参数在这之前已经由固件写进去、并且没被软件复位清掉。")
    }

    CodeRef { file: "tools/nt35510_minimal.tcl"; region: "stop-before-init" }
    CodeRef { file: "handbook/f407/display/nt35510-test.txt"; from: "==== 2"; to: "==== 4"; caption: qsTr("第 2、3 次：硬件复位后再试") }

    KeyPoints {
        label: qsTr("一步步排除")
        points: [
            qsTr("第 2 次：整个芯片复位后马上动手。显存读回 0x0000——这不是屏的问题：复位后固件还没运行，FSMC 时钟、引脚都没配置，写给屏的命令全部落空。读回能帮你分清「没写进去」和「写进去了但显示不对」。"),
            qsTr("第 3 次：复位后让固件跑到 lcd_init 的入口停下（硬件断点）。这时 FSMC 已经配好，而且屏应该已经随芯片一起复位过（按开发板资料，屏的复位脚接在芯片的 NRST 上；这一点本节没有单独验证），厂家参数一条都还没写。做完最少几步，显存读回 0xF800，屏上却是黑的。"),
            qsTr("黑屏不等于屏没工作：固件在 lcd_init 的最后一步才调用 lcd_backlight(80)、用 TIM12 的 PWM 打开背光，停在 lcd_init 入口时背光还没开。用调试器把背光引脚 PB15 直接设成高电平，屏上马上是正常的红色。"),
            qsTr("结论：在这块屏上，不写厂家的电源和伽马参数，显示颜色也正常。「不写就白屏」的说法不成立（至少对这一块屏、这一次测试）。那张表对画质有没有影响，本节没有比较。")
        ]
    }

    Pitfall {
        text: qsTr("排查显示问题时最容易犯的错，是把「看到的现象」直接归因到最先想到的地方。这次三种「不正常」各有各的原因：写不进去（FSMC 没配）、写进去了但看不见（背光没开）、以及根本不存在的「白屏」。"
                 + "每一步先用调试器读回显存，确认数据在不在，再看屏；读回正确而屏不对，才去查电源、伽马、背光这些显示输出的部分。")
    }

    Para {
        text: qsTr("顺带一个速度上的数字：经调试器一个像素一个像素地填满 480 × 800 要将近 4 分钟（233832 ms）；改成每次连续写 64 个像素（0x6C000080–0x6C0000FE 这 64 个地址都算「写数据」）就只要 26 秒。")
    }

    CodeRef { file: "handbook/f407/display/nt35510-test.txt"; from: "==== 4"; caption: qsTr("最后复位板子，固件重新初始化屏幕") }

    Try {
        task: qsTr("第 3 次实验里，如果不去开背光，而是用调试器读回屏的显存，能不能判断屏「其实是好的」？")
        answerNote: qsTr("能判断「显存里的数据是对的」（读回 0xF800），但判断不了「屏能不能把它显示出来」：背光、电源、伽马都在显存之后。所以读回只能排除前两层，第三层必须看屏幕或者测背光电流——这正是这次需要人看的原因。")
    }

    InSystem {
        text: qsTr("工位固件仍然保留厂家参数表（App/lcd.c 的 nt35510_init）：去掉它并不会让屏不亮，但也没有理由冒画质变化的风险。这次排查的结果已经更正到「FSMC 与 8080 并口」一节里。背光由 TIM12 的 PWM 控制，见「PWM 背光」。")
    }
}

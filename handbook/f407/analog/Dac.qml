import QtQuick
import VisionCraft

Section {
    title: qsTr("DAC")
    lead: qsTr("DAC 把一个 12 位的数变成 0 到 VDDA 之间的电压，从 PA4 输出。写进数据寄存器，几个时钟周期后引脚上就是对应的电压。")

    Why {
        text: qsTr("工位上常要输出一个可调的模拟量：给光源调亮度、给比较器设阈值、产生测试波形。DAC 就是做这个的。"
                 + "量电压通常要万用表或示波器，这里有个便利：PA4 既是 DAC 通道 1 的输出，也是 ADC1/ADC2 的输入通道 4。用固件没在用的 ADC2 去读同一个引脚，不用接任何线就能看到 DAC 输出了多少。"
                 + "工位固件不用 DAC 和 PA4。本节用调试器直接配置，测完写回原值。")
    }

    CodeRef { file: "tools/dac_probe.tcl"; region: "setup" }
    CodeRef { file: "tools/dac_probe.tcl"; region: "dac" }

    KeyPoints {
        label: qsTr("配置")
        points: [
            qsTr("PA4 设成模拟模式：关掉数字输入电路，模拟信号直接接到 DAC 和 ADC。在 CubeMX 里打开 DAC 的 OUT1，PA4 会自动变成 DAC_OUT1。"),
            qsTr("DAC_CR 的 EN1 打开通道；BOFF1 决定是否关掉输出缓冲（一个运放）。没开触发时，写进 DHR12R1 的值下一个 APB1 时钟就转到输出寄存器 DOR1。"),
            qsTr("ADC2 只读通道 4，采样时间用最长的 480 个 ADC 时钟，每个点平均 8 次。ADC 的时钟分频是三个 ADC 共用的，由固件为 ADC1 设好了（PCLK2 ÷ 4 = 21 MHz），这里不碰。")
        ]
    }

    CodeRef { file: "handbook/f407/analog/dac-probe.txt"; from: "==== 1"; to: "DAC_DOR1"; caption: qsTr("扫描结果") }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("中间一大段基本是直线：写 2048 读回 2047–2049（缓冲打开），写 1024 读回 1007–1013。"),
            qsTr("缓冲打开时，两头到不了：写 0 到 64 都读回 35–44 左右（约 0.03 V），写 4032 以上都停在 4059–4066（约 3.27 V，比满量程差 30 个码）。输出缓冲是一个运放，它的输出摆幅到不了电源轨（数据手册里对缓冲打开时的输出范围有限制，具体数值以手册为准）。"),
            qsTr("缓冲关闭时更接近两端（写 0 读回约 20，写 4095 读回约 4045），但从 32 到 1024 读回值整体偏高 10–30 个码。关掉缓冲后输出就是电阻网络本身，输出阻抗高，带负载能力差。"),
            qsTr("这些读数里包含了 ADC 自己的误差（偏移、增益），这种「用 ADC 量 DAC」的方法分不开两者。要知道 DAC 到底输出了多少伏，还是要用万用表。电压是按 VDDA = 3.3 V 换算的估计值。")
        ]
    }

    Pitfall {
        text: qsTr("想输出接近 0 V 的电压（比如关掉光源）时，开着缓冲写 0，引脚上实际还有约 0.03 V；写 64 和写 0 几乎没区别。"
                 + "需要贴近两端时，要么关掉缓冲（但外部负载要很轻，比如接一个运放的输入），要么在电路上留出余量，别指望 DAC 的码值就是实际电压。")
    }

    CodeRef { file: "handbook/f407/analog/dac-probe.txt"; from: "==== 2"; to: "缓冲关闭"; caption: qsTr("ADC 采样时间的影响") }

    Para {
        text: qsTr("按道理，关掉缓冲后 DAC 的输出阻抗变高，ADC 采样时间太短时采样电容来不及充满，读数会偏低。实测这里差别不大：3 个周期和 480 个周期只差几个码。"
                 + "我们的推测是：DAC 的输出在两次采样之间一直保持，采样电容每次只需补充很小的电荷。如果 ADC 在几个通道之间切换（采样电容上留着别的通道的电压），影响会大得多；本节只读了一个通道，没有测这种情况。")
    }

    Try {
        task: qsTr("根据扫描结果，缓冲打开时 DAC 码在什么范围内基本是线性的？如果要输出 0.5 V，该写多少？")
        answerNote: qsTr("从表里看，大约 128 到 3968 之间读回值和写入值的差在 35 个码以内（低端偏低、高端偏高，像是增益有约 1% 的误差），可以当作线性段；64 以下和 4032 以上都饱和了。"
                       + "0.5 V 对应 0.5 / 3.3 × 4095 ≈ 620。按表中 512 → 488–495 的读数，实际会略低一点；要准的话，在线性段里用两个点做一次校准。这是对已测数据的推算，没有单独输出 0.5 V 去量。")
    }

    InSystem {
        text: qsTr("手册目录里的下一节「DAC → ADC 回环示波器」会在这个基础上，让 DAC 输出波形、ADC 连续采样，把数据经 RTT 送到上位机画出来。"
                 + "因为 PA4 本身就能同时输出和采样，那一节也不需要额外接线。")
    }
}

+#include "ff.h"
+#include "diskio.h"
+#include "bsp_sdio_sd.h"
+#include "bsp_spi_flash.h"
+
+#define DEV_SD      0   // 逻辑盘 0: MicroSD (SDIO)
+#define DEV_FLASH   1   // 逻辑盘 1: 板载 W25Q128 Flash (12MB 分区)
+
+#define FLASH_FAT_BASE_ADDR   0x00400000UL // 4MB 偏移处开始，预留前 4MB 给裸机字库/测试
+#define FLASH_FAT_SECTOR_SIZE 4096         // 匹配 W25Q128 最小 4KB 擦除扇区
+#define FLASH_FAT_SECTOR_NUM  3072         // 12MB / 4KB = 3072 扇区
+
+DSTATUS disk_status(BYTE pdrv) {
+    switch (pdrv) {
+    case DEV_SD:
+        return Bsp_Sd_GetInfo()->is_initialized ? 0 : STA_NOINIT;
+
+    case DEV_FLASH:
+        return Bsp_SpiFlash_GetInfo()->is_detected ? 0 : STA_NOINIT;
+
+    default:
+        return STA_NOINIT;
+    }
+}
+
+DSTATUS disk_initialize(BYTE pdrv) {
+    switch (pdrv) {
+    case DEV_SD:
+        return (Bsp_Sd_Init() == SD_OK) ? 0 : STA_NOINIT;
+
+    case DEV_FLASH:
+        return Bsp_SpiFlash_GetInfo()->is_detected ? 0 : STA_NOINIT;
+
+    default:
+        return STA_NOINIT;
+    }
+}
+
+DRESULT disk_read(BYTE pdrv, BYTE *buff, LBA_t sector, UINT count) {
+    switch (pdrv) {
+    case DEV_SD:
+        if (Bsp_Sd_ReadBlocks(buff, (uint32_t)sector, count, 2000) != SD_OK) {
+            return RES_ERROR;
+        }
+        return RES_OK;
+
+    case DEV_FLASH: {
+        uint32_t addr = FLASH_FAT_BASE_ADDR + ((uint32_t)sector * FLASH_FAT_SECTOR_SIZE);
+        uint32_t total_bytes = count * FLASH_FAT_SECTOR_SIZE;
+        Bsp_SpiFlash_Read(addr, buff, total_bytes);
+        return RES_OK;
+    }
+
+    default:
+        return RES_PARERR;
+    }
+}
+
+DRESULT disk_write(BYTE pdrv, const BYTE *buff, LBA_t sector, UINT count) {
+    switch (pdrv) {
+    case DEV_SD:
+        if (Bsp_Sd_WriteBlocks(buff, (uint32_t)sector, count, 2000) != SD_OK) {
+            return RES_ERROR;
+        }
+        return RES_OK;
+
+    case DEV_FLASH: {
+        uint32_t addr = FLASH_FAT_BASE_ADDR + ((uint32_t)sector * FLASH_FAT_SECTOR_SIZE);
+        for (UINT i = 0; i < count; i++) {
+            uint32_t sec_addr = addr + (i * FLASH_FAT_SECTOR_SIZE);
+            Bsp_SpiFlash_EraseSector(sec_addr);
+            Bsp_SpiFlash_Write(sec_addr, buff + (i * FLASH_FAT_SECTOR_SIZE), FLASH_FAT_SECTOR_SIZE);
+        }
+        return RES_OK;
+    }
+
+    default:
+        return RES_PARERR;
+    }
+}
+
+DRESULT disk_ioctl(BYTE pdrv, BYTE cmd, void *buff) {
+    switch (pdrv) {
+    case DEV_SD:
+        switch (cmd) {
+        case CTRL_SYNC:
+            return RES_OK;
+        case GET_SECTOR_COUNT:
+            *(LBA_t *)buff = (LBA_t)Bsp_Sd_GetInfo()->block_count;
+            return RES_OK;
+        case GET_SECTOR_SIZE:
+            *(WORD *)buff = (WORD)Bsp_Sd_GetInfo()->block_size;
+            return RES_OK;
+        case GET_BLOCK_SIZE:
+            *(DWORD *)buff = 1;
+            return RES_OK;
+        default:
+            return RES_PARERR;
+        }
+
+    case DEV_FLASH:
+        switch (cmd) {
+        case CTRL_SYNC:
+            return RES_OK;
+        case GET_SECTOR_COUNT:
+            *(LBA_t *)buff = FLASH_FAT_SECTOR_NUM;
+            return RES_OK;
+        case GET_SECTOR_SIZE:
+            *(WORD *)buff = FLASH_FAT_SECTOR_SIZE;
+            return RES_OK;
+        case GET_BLOCK_SIZE:
+            *(DWORD *)buff = 1;
+            return RES_OK;
+        default:
+            return RES_PARERR;
+        }
+
+    default:
+        return RES_PARERR;
+    }
+}

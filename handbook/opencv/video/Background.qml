import QtQuick
import VisionCraft

Section {
    title: qsTr("背景建模")
    lead: qsTr("背景建模记住「平时这里长什么样」，和平时不一样的像素就是前景。它的关键参数是学习速度：学得快，适应光照变化，但运动慢的物体也会被学成背景；学得慢，物体留得住，但环境一变就满屏误报。")

    Why {
        text: qsTr("固定相机看一个场景，找出「来了什么东西」，是背景建模最典型的用途。示例用上一节的传送带视频：垫圈随传送带每帧右移 4 像素，第 40 帧起整条传送带停住。"
                 + "因为每一帧垫圈在哪都是已知的，可以精确算出它被检出了多少、前景里又有多少是误报。")
    }

    CodeRef { file: "examples/opencv/video/main.cpp"; region: "mog2" }
    CodeRef { file: "examples/opencv/video/output.txt"; from: "==== 2"; to: "0.002"; caption: qsTr("实际输出（每格：垫圈被检出的比例 / 前景里不属于垫圈的像素数）") }
    Figure { files: ["handbook/opencv/figures/mog2-20.png"]; captions: [qsTr("学习速度 0.002，第 20 帧的前景：垫圈大部分出来了，旁边还有传送带条纹的误报")] }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("自动学习速度（−1）：开头几帧学得极快，垫圈刚出现就被学进背景，最多只检出 36%；传送带停下后 20 帧，垫圈完全「消失」了。"),
            qsTr("0.002：慢慢学，运动中的垫圈检出 84%，停下来 20 帧后仍然检出 84%，到第 79 帧才降到 54%。代价是开头几帧和停下之后，前景里有六七千个不属于垫圈的像素——条纹从「一直在动」变成「不动了」，对模型来说也是一种变化。"),
            qsTr("0.01 介于两者之间。没有哪个值在所有情况下都好：要看物体停留多久、光照变化多快。")
        ]
    }

    Pitfall {
        text: qsTr("我原先以为检出率低是因为「垫圈表面是均匀的，移动时只有前后边缘的像素在变」。加了统计才发现不是：内部也有一半以上的检出像素，真正的原因是自动学习速度在开头太快。"
                 + "排查这类问题时，先把可疑的因素单独量出来（这里是按「外缘一圈」和「里面」分别统计），而不是凭直觉解释数字。")
    }

    Pitfall {
        text: qsTr("背景建模的第一帧，所有像素都是前景（模型还什么都不知道）。实际使用时要先空跑一段只有背景的画面，或者前若干帧的结果直接丢弃。")
    }

    Try {
        task: qsTr("如果传送带不停，而是车间的灯慢慢变暗（每帧整体暗 0.5），学习速度 0.002 和自动，哪个会产生更多误报？")
        answerNote: qsTr("方向猜对了，程度猜错了。本机实测：静止的画面，每帧整体变暗 0.25%，200 帧后暗了一半；第 199 帧时 0.002 有 93 个误报像素，自动学习速度只有 19 个。"
                       + "学得慢的确跟不上亮度变化，但 MOG2 给每个像素记的是一个分布（均值和方差），缓慢的漂移大多仍落在分布里，并没有出现我预计的「大面积误报」。"
                       + "再试突然变暗 30%（开关灯）：两种学习速度都立刻满屏误报（自动 100%、0.002 也有 68% 的像素），过了 100 帧才都恢复。突然的光照变化，单靠背景建模哪种参数都扛不住。")
    }

    InSystem {
        text: qsTr("工位一次只拍一个工件，不需要背景建模。数据由 examples/opencv/video 测得。")
    }
}

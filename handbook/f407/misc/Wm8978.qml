import QtQuick
import VisionCraft

Section {
    title: qsTr("WM8978 音频")
    lead: qsTr("WM8978 是一颗音频编解码芯片：数字声音从 I2S 进来，它转成模拟信号推耳机和喇叭。它用两条通道和单片机打交道——I2C 写配置，I2S 传声音数据。")

    Why {
        text: qsTr("工位上除了蜂鸣器「嘀」一声，有时需要真正的提示音或语音（「工件不合格，请取走」）。蜂鸣器只能发一个频率，WM8978 能放任意声音。"
                 + "本节用调试器完成全部配置：I2C1 写 WM8978 的寄存器，I2S2 由 DMA 循环发送一张 1 kHz 的正弦表，然后请人在板子旁边听。工位固件不用 I2S2 和 WM8978，I2C1 和 EEPROM 共用（固件已初始化好），测完写回原值。")
    }

    CodeRef { file: "handbook/f407/misc/wm8978.txt"; from: "==== 0"; to: "EEPROM"; caption: qsTr("I2C1 总线上的两个器件") }
    CodeRef { file: "tools/wm8978_probe.tcl"; region: "codec" }

    KeyPoints {
        label: qsTr("配置 WM8978")
        points: [
            qsTr("WM8978 只能写、不能读：每次写 2 个字节，前 7 位是寄存器号，后 9 位是数据。地址 0x1A 有应答，说明它在总线上；但写进去对不对，只能听结果。"),
            qsTr("要做的事：上电偏置和参考电压（R1）、打开耳机输出（R2）和 DAC、混音器（R3）、接口格式选 I2S 飞利浦 16 位（R4）、时钟从 MCLK 直接取、自己当从机（R6），把 DAC 接到输出混音器（R50、R51），最后设耳机音量（R52、R53）。"),
            qsTr("音量寄存器 0–63，57 是 0 dB，每级 1 dB。左右两个寄存器写完，第二个要置 bit8（更新位），两边才同时生效。"),
            qsTr("板上还有一个喇叭，经功放接在 WM8978 的第二路输出（LOUT2 / ROUT2）上，要另外打开（R3 的另两位、R54、R55）。")
        ]
    }

    CodeRef { file: "tools/wm8978_probe.tcl"; region: "i2s" }

    KeyPoints {
        label: qsTr("I2S 这一路")
        points: [
            qsTr("I2S 有四根线：位时钟 CK（PB13）、左右声道选择 WS（PB12）、数据 SD（PC3），以及主时钟 MCK（PC6，给 WM8978 当工作时钟，是采样率的 256 倍）。都是 SPI2 的复用功能 5。"),
            qsTr("I2S 的时钟不来自主 PLL，而是单独的 PLLI2S：1 MHz × 258 ÷ 3 = 86 MHz，再按 86 MHz ÷ 256 ÷ (2 × 3 + 1) 得到 47991 Hz 的采样率，和 48 kHz 差 0.02%。这是 ST 例程里常用的 48 kHz 参数组合。"),
            qsTr("声音数据是左右声道交替的 16 位数：正弦表 48 个点（48 kHz 下正好 1 kHz），每个点左右各放一份。DMA1 流 4 循环搬运，CPU 不用管。"),
            qsTr("播放期间 DMA 的剩余计数一直在变，SPI2 的状态寄存器没有出现欠载（UDR）位，说明数据持续送出去了。")
        ]
    }

    CodeRef { file: "handbook/f407/misc/wm8978.txt"; from: "HP_VOL 25"; caption: qsTr("三次播放，以及听的人听到了什么") }

    Pitfall {
        text: qsTr("第一次播放，音量设成 25，什么也没听到。寄存器都写成功了，DMA 也在跑，问题出在「太小声」：25 相当于 −32 dB，测试信号本身也只有满幅的约 18%（−15 dB），合起来约 −47 dB，耳机拿在耳边听不出来。"
                 + "第二次把耳机音量调到 40（约 −17 dB），同时打开喇叭，听到了；第三次只开耳机、音量 40，耳机里清楚地有「嘟」声。"
                 + "调音频时「没声音」可能是通路没打开，也可能只是太小——先用一个肯定听得见、但不刺耳的音量确认通路，再往下调。第一次试的时候别把耳机直接戴在耳朵上。")
    }

    Try {
        task: qsTr("正弦表是 48 个点，采样率 48 kHz，所以是 1 kHz。如果想放 440 Hz（标准音 A），表要多少个点？会遇到什么问题？")
        answerNote: qsTr("48000 ÷ 440 ≈ 109.09，不是整数。取 109 个点，实际频率是 48000 ÷ 109 ≈ 440.4 Hz，差约 0.1%，人耳一般听不出来；如果要精确，可以让表里放好几个周期（比如 11 个周期正好是 1200 个点，48000 × 11 ÷ 1200 = 440 Hz）。这是按采样率的计算，没有单独播放 440 Hz。")
    }

    InSystem {
        text: qsTr("工位固件目前只用蜂鸣器提示。要加语音提示，就在 station.ioc 里打开 I2S2 和 DMA，固件启动时按本节写 WM8978 的寄存器，把提示音存在 SPI Flash 或 FatFs 里（见前面几节），需要时由 DMA 播放。")
    }
}

import QtQuick
import VisionCraft

Section {
    title: qsTr("空间与多图成像：综合作业与答案")
    lead: qsTr("先明确模型、坐标和数据语义，再选择计算与显示方式。")
    Why { text: qsTr("这些题把Qt场景、OpenCV多图运算与系统结果发布串起来。先独立推导，再用固定示例观察对应步骤；无需相机或开发板。") }
    Try { task: qsTr("1. 坐标链：世界点(100,50,0)，相机在(0,0,500)，方向与示例相同，fx=fy=500、主点(319.5,239.5)。求相机点和像素。"); answerNote: qsTr("相机点为(100,-50,500) mm，像素为(419.5,189.5)。Y方向翻转来自明确坐标约定，不是在最终图上随意翻转。") }
    Try { task: qsTr("2. 节点层次：比较R×(p+t)与R×p+t。让p=0、t=(100,0,0)，绕Y转90度。"); answerNote: qsTr("前者得到(0,0,-100)，后者得到(100,0,0)。先判断t属于局部还是世界，再决定层次。") }
    Try { task: qsTr("3. 视野：固定图像高度480，焦距从500增加到1000，垂直FOV如何变化？"); answerNote: qsTr("分别是2atan(240/500)和2atan(240/1000)，焦距增加使FOV减小；不要把像素焦距当成毫米焦距。") }
    Try { task: qsTr("4. 拾取：鼠标向右拖40像素，就让模型向世界X移动40毫米，这个解释缺什么？"); answerNote: qsTr("缺少深度和约束平面/交互映射。示例明确采用每像素0.25度的旋转，不宣称世界长度。") }
    Try { task: qsTr("5. 公共画布：A范围[0,320]，B以H向左120像素，图高都为240。给出画布原点、宽高和T。"); answerNote: qsTr("原点(-120,0)，宽440、高240；T向右120。A进入输出的x=120起点，B从0起点开始。") }
    Try { task: qsTr("6. 有效性：两张图都观测到黑色方块，重叠区的图像值为0。应该怎样传播mask和权重？"); answerNote: qsTr("mask仍为有效，权重从覆盖/距离获得，不能用像素值构造；颜色为0不意味着缺失。") }
    Try { task: qsTr("7. 方法选择：曝光不一致与运动重影分别应该观察哪些中间量？"); answerNote: qsTr("曝光查看对齐后的颜色与截断，运动查看对应轮廓和局部不一致；先固定H比较覆盖、羽化、多频段，再判断是否需要超出本示例的曝光补偿或去鬼影。") }
    Try { task: qsTr("8. 低纹理：已知H模式成功，开启ORB估计失败。这是否是实现前后矛盾？"); answerNote: qsTr("不是。前者已得到几何答案，后者需要从观测求答案。融合能执行不代表匹配可辨识。") }
    Try { task: qsTr("9. 曝光：把一张8位过曝图片乘0.25再保存，能否拿它代替真实短曝光恢复高光细节？"); answerNote: qsTr("不能。已经被截断的信息没有恢复；本项目曝光组从线性高动态场景分别曝光后编码。") }
    Try { task: qsTr("10. HDR：Mertens图、MergeDebevec浮点数组、Reinhard显示图，哪一个可称为本例恢复的HDR数据？"); answerNote: qsTr("MergeDebevec浮点数组。Mertens是曝光融合的显示结果，Reinhard是色调映射结果；本例还明确使用已知响应，不能冒称相机响应估计。") }
    Try { task: qsTr("11. 视差：f=500，横移80，两个相机深度为500与400。两层的像素位移与平面补偿残差是多少？"); answerNote: qsTr("位移分别为-80与-100，按远平面补偿后近层仍有-20像素残差，绝对值20；结论要求零旋转和平行横移。") }
    Try { task: qsTr("12. 结果生命周期：后台按参数A计算，期间改成B并离开手册，返回后应显示什么？"); answerNote: qsTr("活动演示应已销毁且不自动重启；A结果不能作为B结果发布。重新开始时提交明确参数，独立阅读正文不受后台任务状态影响。") }
    Para { text: qsTr("综合练习：选一个曝光不一致案例和一个局部错位案例，分别固定H对照三种融合。写出你观察到的变化属于几何、光度还是显示；说明用到的真值和仍未解决的问题。答案不以图片更漂亮为标准，而以解释是否符合模型与中间量为标准。") }
    InSystem { text: qsTr("阅读顺序：Qt/三维场景 → OpenCV/多图成像 → 系统/空间与图像。数值目标为example_multiimage_lessons与example_projection_lesson，Quick3D目标example_spatial_lessons为源码选配。两个应用内演示通过手册显式启动。") }
}

import QtQuick
import VisionCraft

Section {
    title: qsTr("卡尺测量")
    lead: qsTr("沿一条线取亮度剖面，找亮度变化最快的位置，就是边缘。只取整数像素，精度是 1 像素；用边缘附近三个点拟合一条抛物线，可以量到零点一像素。")

    Why {
        text: qsTr("工业检测里很多判断是尺寸：孔径、间距、壁厚是否在公差内。工位用轮廓拟合量圆，那是对整个圆求平均；卡尺是在指定的位置、沿指定的方向量一个距离，更灵活，也是视觉测量软件里最常用的工具。"
                 + "示例画了外径 110、环宽分别为 60、60.25、60.5、60.75、61 像素的理想垫圈（在 8 倍分辨率上画再缩小，边缘是真实的部分覆盖灰度），看能不能量出四分之一像素的差别。")
    }

    CodeRef { file: "examples/opencv/measure/main.cpp"; region: "caliper" }
    KeyPoints {
        points: [
            qsTr("getRectSubPix 在小数坐标处双线性取样，所以卡尺的方向可以是任意角度，不限于横竖。"),
            qsTr("中心差分求导：(后一点 − 前一点) / 2。导数最大处是整数位置的边缘。"),
            qsTr("亚像素：导数在边缘附近是一个尖峰，用峰值点和左右两点拟合抛物线，顶点的位置就是亚像素边缘，偏移量 = (左 − 右) / (2 × (左 − 2·中 + 右))。")
        ]
    }

    CodeRef { file: "examples/opencv/measure/output.txt"; from: "==== 2"; to: "61.00"; caption: qsTr("实际输出") }
    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("整数像素的结果是 61、61、61、61、62：四分之一像素的变化完全看不出来，而且整体偏大 1。"),
            qsTr("亚像素的结果是 60.10、60.35、60.61、60.87、61.11：每一步都跟着真实值涨了约 0.25，只有一个固定的 +0.1 偏差。固定的偏差可以用一件已知尺寸的标准件标定掉，跟随变化的能力才是关键。")
        ]
    }

    Pitfall {
        text: qsTr("这里的「像素」只是图像上的单位。要换算成毫米，需要知道一个像素对应多少毫米（相机标定，或者拍一个已知尺寸的标准件）。"
                 + "而亚像素精度依赖边缘本身是清晰、平滑的：噪声大、边缘模糊、光照在边缘处不均匀，都会让拟合出的顶点漂移。上面的结果是在噪声只有 3 的理想条件下得到的。")
    }

    Try {
        task: qsTr("示例只在 +x 方向量了一次。如果垫圈有一点点偏心（内孔不在正中），只量一个方向得到的「环宽」会怎样？怎样量才能得到可靠的环宽？")
        answerNote: qsTr("偏心时环宽沿圆周变化：一边宽一边窄，只量一个方向得到的是那个方向上的宽度，不代表整体。做法是沿多个方向（比如每 30° 一条卡尺）各量一次，取最小值（判断最薄处是否合格）或平均值，"
                       + "并且同时检查这些值的差异——差异大本身就说明偏心。工位的偏心判断用的是两个拟合圆心的距离，是同一个问题的另一种量法。")
    }

    InSystem {
        text: qsTr("工位检测用轮廓拟合量半径和圆心，没有用卡尺。数据由 examples/opencv/measure 测得。")
    }
}

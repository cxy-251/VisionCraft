import QtQuick
import VisionCraft

Section {
    title: qsTr("分水岭")
    lead: qsTr("两个物体挨在一起，二值化后是一整块，连通域只数出 1 个。分水岭从每个物体内部的一个「种子」出发同时往外灌水，两股水相遇的地方就是分界线。关键在于种子从哪来。")

    Why {
        text: qsTr("传送带上零件挤在一起、显微镜下细胞粘连，都要把一块拆成几个。示例画两个重叠 20 像素的圆，用距离变换找种子，再用分水岭分开。")
    }

    CodeRef { file: "examples/opencv/measure/main.cpp"; region: "watershed" }
    CodeRef { file: "examples/opencv/measure/output.txt"; from: "==== 4"; caption: qsTr("实际输出") }
    Figure { files: ["handbook/opencv/figures/watershed.png"]; captions: [qsTr("分水岭结果：两块各一种颜色，红色是标成 −1 的分界线（包括四周和外轮廓）")] }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("直接数连通域只有 1 个。距离变换后，「离边缘超过 42 像素」的点只出现在两个圆的中心附近，各成一块——这就是两个种子。种子的阈值要比两圆重叠处的厚度大，否则两个种子会连在一起。"),
            qsTr("分水岭把标记为 −1 的像素当作分界线。它不只标两块之间的那条线，也标每块和背景之间的轮廓、以及图像的四周：一共 2045 个，其中真正落在白色区域里的只有 769 个。"),
            qsTr("核对：两块的面积加上白色区域里的分界线，正好等于原图白色像素 34457，一个不多一个不少。")
        ]
    }

    Pitfall {
        text: qsTr("watershed 的输入必须是三通道的 8 位图（示例把二值图转成了彩色），标记图必须是 CV_32S；它会直接改写标记图。"
                 + "而且分水岭对种子非常敏感：种子多一个，就多分出一块（过分割）；两个物体只给了一个种子，就分不开。种子的质量决定了一切，分水岭本身只负责划线。")
    }

    Try {
        task: qsTr("如果两个圆的重叠从 20 像素增加到 80 像素，示例里「0.6 × 70 = 42」的种子阈值还能分出两个种子吗？")
        answerNote: qsTr("两圆中心距离 130 → 70 时，连接处的「腰」变粗，腰部中心离边缘的距离也会增大；当它超过 42 时，两个种子就连成一块，分水岭只能得到 1 个区域。"
                       + "本机把右圆圆心从 270 移到 210 实测：只得到 1 个种子，分水岭也就只有 1 块（27377 像素）。种子阈值要根据物体大小和重叠程度定，没有万能的值。")
    }

    InSystem {
        text: qsTr("工位一次只检测一个垫圈，不需要分割粘连物体。数据由 examples/opencv/measure 测得。")
    }
}

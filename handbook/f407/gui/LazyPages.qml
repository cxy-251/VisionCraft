import QtQuick
import VisionCraft

Section {
    title: qsTr("只保留当前页：LVGL 页面的建与删")
    lead: qsTr("每个 LVGL 控件都要在内存池里占一两百字节。开机把所有页面都建好，每加一页内存就涨一截，五页就用掉了 36 KB（总共 44 KB）。改成「进哪页才建哪页，离开就删」之后，那一轮峰值降到 17 KB。后续文件页更大，应以新测量为准；按需销毁能限制同时存活的页面对象，缓存等额外占用仍需另外计量。")

    Why {
        text: qsTr("接下来要加设置页、几个小游戏、画板。按原来的做法，内存池的峰值一路是：只有演示页时约 10 KB，加工位页 17.6 KB，加传感器、设备页 29.6 KB，加终端页 36 KB。再加就放不下了。"
                 + "有两种办法：把内存池挪到 1 MB 的外部 SRAM，或者不再同时保留所有页面。两种都试了，量完再选。")
    }

    CodeRef { file: "handbook/f407/gui/lazy-test.txt"; from: "==== 1"; to: "慢在 LVGL"; caption: qsTr("内存池放在 CCM 和放在外部 SRAM：每页进两次，记进入那一帧") }

    KeyPoints {
        label: qsTr("试一：内存池放到外部 SRAM")
        points: [
            qsTr("改动只有两行：lv_conf.h 里 LV_MEM_SIZE 改成 256 KB，LV_ATTRIBUTE_LARGE_RAM_ARRAY 改成外部 SRAM 的段（LVGL 源码里只有内存池用这个属性），绘图缓冲改成直接指定留在 CCM。"),
            qsTr("内存一下子宽裕了，但整屏一帧慢了 50–70%：工位页第二次进入从 76.7 ms 变成 117.0 ms，传感器页从 92.2 变成 156.1。写屏时间一点没变（都是 24 ms），慢的是 LVGL 在内存里画图：画每个控件都要反复读它的位置、样式，现在这些都在要走 FSMC 的外部 SRAM 上。"),
            qsTr("游戏要不停地刷新，这个代价太大，放弃。")
        ]
    }

    CodeRef { file: "firmware/station/App/lv_ui.c"; region: "pages" }
    CodeRef { file: "firmware/station/App/page_station.c"; region: "enter" }

    KeyPoints {
        label: qsTr("采用：只保留当前页")
        points: [
            qsTr("界面框架的页面多了一个 leave 回调，进入别的页面或返回时调用。LVGL 页面在 enter 里建控件、填数据，在 leave 里删掉整个屏幕对象，LVGL 把它和所有子控件占的内存还回内存池。"),
            qsTr("删之前要先切到一个空屏幕：LVGL 不允许删正在显示的那个屏幕。"),
            qsTr("关键是数据和控件分开：检测结果、缩略图、传感器历史、终端的输出都存在普通变量里。上位机发来结果时，工位页不在前台就只记数据；进来时 build 完再把数据填进控件。以前是直接改控件，控件一直在，所以没这个问题。"),
            qsTr("所有改控件的函数都先看页面还在不在（屏幕指针是不是空的）。删掉以后忘了检查、还去改控件，就是在写已经释放的内存——这类错误往往不会马上出事，而是过一会儿在别处莫名其妙地坏掉。")
        ]
    }

    CodeRef { file: "handbook/f407/gui/lazy-test.txt"; from: "==== 3"; to: "内存池"; caption: qsTr("只保留当前页：每页进两次") }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("走遍所有页面后，内存池峰值 16784 字节（原来 36220）。最大的终端页显示时用 11424 字节，44 KB 里还有 30 多 KB 余量。"),
            qsTr("每次进入都和原来的「第一次进入」一样：90–110 ms，不再有第二次更快的情况——因为每次都是新建的控件，要重新算一遍布局。换页时框架的时间（包括建控件）从约 24 ms 变成 31–43 ms，也就是建一页控件要 7–19 ms。"),
            qsTr("原来的触摸注入、LVGL 演示页、工位页缩略图、终端页的测试都照旧通过：缩略图离开再回来还在（它在外部 SRAM 的 s_thumb 里，不在控件里），终端的输出、演示页的点击次数和滑块位置也都还在。"),
            qsTr("CCM 又回到 92%（44 KB 内存池 + 15 KB 绘图缓冲），但内存池里够用了。")
        ]
    }

    Pitfall {
        text: qsTr("演示页的温度曲线是例外：它只在页面显示时每秒加一个点，离开后控件和点一起删掉，回来重新开始。这是有意的简化——要保留，就像传感器页那样把点存进一个数组，建页面时整段填回去。")
    }

    Try {
        task: qsTr("如果某个页面需要在后台持续动画（比如游戏离开时还要接着计时），这种「离开就删」的做法还行吗？")
        answerNote: qsTr("推测：动画和计时本身应该放在数据里（比如记下开始时刻），不放在控件里，回来时按当前时刻重画即可；真正需要后台运行的逻辑放在 tick 以外（比如 pages_background）。LVGL 控件只是把数据画出来的一层。本题没有实测。")
    }

    InSystem {
        text: qsTr("这次实验先改了五个 LVGL 页面（工位、传感器、设备、演示、终端）；后续设置页、游戏、画板和文件页也已采用同一机制：数据放在变量里，enter 里建，leave 里删。")
    }
}

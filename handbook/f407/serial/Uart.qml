import QtQuick
import VisionCraft

Section {
    title: qsTr("UART：轮询、中断、DMA")
    lead: qsTr("UART 两根线、不带时钟：双方事先约好波特率，接收方按自己的时钟去数每一位。所以波特率的误差直接决定能不能通信。本节不接任何线，用「单线半双工」让 USART 自己收自己发的数据。")

    Why {
        text: qsTr("工位和 PLC、扫码枪、上位机的串口通信都是 UART。正常的测试要把板子的串口接到电脑上（本板 USB_232 口上的 CH340 接 USART1），但这次电脑没有空余的 USB 口。"
                 + "USART 有一个单线半双工模式：发送和接收共用一根线（TX 脚），自己发出的每一位，接收器也同时收到。用它可以在不接线的情况下检验配置、DMA、以及实际的波特率。"
                 + "示例用工位固件没用的 USART3（PB10，板上 ATK 模块座的串口，现在没插模块），全部由调试器配置，测完写回原值。上位机那一侧见「QSerialPort 串口」。")
    }

    CodeRef { file: "tools/uart_probe.tcl"; region: "setup" }

    KeyPoints {
        label: qsTr("配置")
        points: [
            qsTr("波特率由 BRR 决定：过采样 16 倍时，BRR = 外设时钟 ÷ 波特率。USART3 挂在 APB1 上，时钟 42 MHz；42 MHz 除不尽时只能取最接近的整数，于是有理论误差：115200 是 −0.11%，921600 是 −0.93%（BRR 只能取 46），9600 和 2000000 正好除尽。"),
            qsTr("CR3 的 HDSEL 打开单线半双工，DMAT、DMAR 让发送、接收都由 DMA 搬运。PB10 设成复用功能 7，并打开上拉：UART 空闲时线是高电平，起始位是一个低电平。"),
            qsTr("8 位数据、无校验、1 个停止位（8N1）时，一个字节在线上是 10 位：起始位、8 个数据位、停止位。这就是「115200 波特 ≈ 每秒 11520 字节」的来历。")
        ]
    }

    KeyPoints {
        label: qsTr("三种收发方式")
        points: [
            qsTr("轮询：程序一直查 TXE / RXNE 标志，一个字节一个字节地写和读。简单，但 CPU 什么别的也干不了；115200 下每 87 µs 就要处理一个字节，稍有耽误接收就溢出（ORE）。"),
            qsTr("中断：每收到一个字节进一次中断，把它放进缓冲区。CPU 平时可以干别的，但高波特率时中断非常频繁（2 Mbps 时每 5 µs 一次）。"),
            qsTr("DMA：DMA 直接在外设和内存之间搬，整段数据收发完才通知一次。本节用的就是这种：2000 字节由两个 DMA 流分别负责发送和接收，CPU（工位固件）照常运行。不定长的接收通常配合「空闲线检测」（IDLE 中断）来判断一帧什么时候结束。")
        ]
    }

    CodeRef { file: "tools/uart_probe.tcl"; region: "dma" }
    CodeRef { file: "tools/uart_probe.tcl"; region: "measure" }
    CodeRef { file: "handbook/f407/serial/uart-probe.txt"; caption: qsTr("在板子上运行的结果") }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("四种波特率下，2000 字节发出去、收回来完全一致——连 2 Mbps 也没问题，因为收发用的是同一个时钟，误差完全一样。两台设备之间就不一样了：双方误差的差加起来超过约 ±3–4%，接收方在一个字节的末尾就会数错位。"),
            qsTr("实测波特率：9600 是 9597–9601，115200 是 114962–115401，和理论值相差 0.2% 以内。921600 和 2000000 的实测在 ±2% 内跳动：一次传输只有 10–20 ms，调试器几百微秒的延迟抖动就占了 1–2%，分辨不出 921600 那 −0.93% 的理论误差。"),
            qsTr("SR = 0x00D0：发送完成（TC）、发送缓冲空（TXE）和空闲线（IDLE）置位，没有溢出、噪声、帧错误。")
        ]
    }

    Pitfall {
        text: qsTr("第一版脚本直接用「发 2000 字节的耗时」算波特率，2 Mbps 时算出 −14% 的误差，看起来像是严重的配置错误。其实是调试器的问题：它要一两毫秒才发现「收完了」，这段延迟每次都被算进去，传输越短占比越大。"
                 + "改成发 2000 字节和 500 字节各一次、两个耗时相减，固定的延迟就抵消了。测量时间的时候，先想清楚测量手段本身的开销有多大。")
    }

    Try {
        task: qsTr("板子和一个用 8 MHz 晶振、BRR 算出来误差 +2% 的设备以 115200 通信，这块板子（−0.11%）能稳定收到它发的数据吗？")
        answerNote: qsTr("两边相差约 2.1%。接收方在起始位的下降沿开始计时，每位在中间采样；到第 10 位（停止位）时累计偏差约 10 × 2.1% ≈ 21% 个位宽，还没超过半个位宽（50%），通常能收，但余量已经不多，再加上线路上的边沿失真就可能出错。一般的经验是双方误差之差控制在 2% 以内。这是按 UART 采样原理的估算，本节没有和另一台设备实测。")
    }

    InSystem {
        text: qsTr("本程序和板子的通信走调试器的 RTT（见「RTT：经调试口通信」）。上位机里有串口通道（src/device/SerialTransport），但工位固件（station.ioc）目前没有配置任何 USART，所以串口这条路在固件一侧还不存在。以后加上时，接法是板子的 USB_232 口 → CH340 → USART1；等电脑有空余的 USB 口，再实测「QSerialPort 串口」里留下的两个问题：波特率不一致时收到什么、拔掉 USB 线时上位机报什么错。")
    }
}

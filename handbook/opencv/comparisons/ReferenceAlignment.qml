import QtQuick
import VisionCraft
Section {
    title: qsTr("测量选择：标样差分为何先要求对齐")
    lead: qsTr("两张图逐像素相减之前，必须确认同一坐标是否代表同一个位置。位姿差、亮度差和实际缺陷都能产生差异图，差异本身还不是缺陷答案。")
    Why { text: qsTr("黄金标样与仿射变换已有章节。本节集中讨论它们之间的前提：怎样区分未对齐、正常变化与真正需要查找的异常，并防止对齐过程把异常也消掉。") }
    CodeRef { file: "examples/opencv/measure/main.cpp"; region: "golden" }
    CodeRef { file: "examples/opencv/measure/output.txt"; from: "==== 1"; to: "环面中间"; caption: qsTr("已有标样差分结果") }
    KeyPoints {
        label: qsTr("差异减少不等于全部正确")
        points: [
            qsTr("已有示例差异大于40的像素从9779降到3834，使用的是按圆心平移(−2,13)后的对齐。对齐解释了一部分差异，没有把全部剩余差异都认作缺陷。"),
            qsTr("3834中3713在内外边缘附近，121在环面中间；正常几何差异、采样和模拟表面差异仍会影响结果。只看全图差异数量，会掩盖差异出现的位置。"),
            qsTr("平移只处理位置偏移。旋转、尺度或透视变化需要相应变换；选用更灵活模型，也会引入估计不稳定或把目标变化吸收进变换的问题。"),
            qsTr("标准样必须有明确来源与适用条件。另一件合格品的自然纹理不一定逐像素相同；相机与光照变化也需要单独建模，不能靠无限降低或提高差分阈值解决。")
        ]
    }
    Para { text: qsTr("一个合理顺序是先选稳定的定位特征与允许的变换，再把比较限制在有意义的区域，最后按任务定义解释差异。不能为了让差异最少，随意让对齐模型拉伸工件，把本来应测量的形变一并消除。") }
    Pitfall { text: qsTr("若异常本身参与了定位，对齐可能被异常带偏；若比较全图，又可能把背景变化当异常。定位区域、比较区域、忽略边界区域应有理由，而不是看了结果后任意删去不满意的部分。") }
    Try { task: qsTr("若任务就是测量孔径变化，允许对齐阶段自由缩放孔，可能发生什么？差分全黑能否证明零件没有问题？"); answerNote: qsTr("缩放可能吸收孔径变化，让待测异常被变换抹去。全黑只说明在当前预处理、对齐、范围与阈值定义下没有差异，不能脱离这些条件证明产品无异常。") }
    InSystem { text: qsTr("连接已有Golden、Affine、Perspective、Homography与掩膜章节。配套使用已有measure示例材料，本课不增加对齐工具或外部图片依赖。") }

import QtQuick
import VisionCraft

Section {
    title: qsTr("标准样差分")
    lead: qsTr("拿一件合格品当「标准样」，和待检件逐像素相减，差得多的地方就是缺陷。思路最直接，前提却最苛刻：两件必须对得严丝合缝。")

    Why {
        text: qsTr("黑帽变换只能找「比周围暗的小东西」（「腐蚀、膨胀、开闭运算」一节），大面积的缺陷、多出来的东西、颜色不对，它都看不出来。和标准样相减，理论上任何差别都能发现。"
                 + "示例从模拟产线取一件合格品当标准样、一件带污点的当待检件，看相减之后剩下什么。")
    }

    CodeRef { file: "examples/opencv/measure/main.cpp"; region: "golden" }
    CodeRef { file: "examples/opencv/measure/output.txt"; from: "==== 1"; to: "环面中间"; caption: qsTr("实际输出（「边缘附近」= 离外缘或内孔边缘 8 像素以内）") }
    Figure {
        files: ["handbook/opencv/figures/golden-raw.png", "handbook/opencv/figures/golden-aligned.png"]
        captions: [qsTr("直接相减：两件位置不同，到处都是差异"), qsTr("按圆心对齐后：污点出来了，但两圈边缘也还在")]
    }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("直接相减，差异像素近 1 万个：两件在传送带上的位置差了 13 像素，整个垫圈都错开了。"),
            qsTr("按拟合出的圆心平移对齐，降到 3834 个，传送带上一个都不剩（「平移对齐」本身是成功的）。"),
            qsTr("但其中 3713 个在垫圈的两圈边缘上：模拟产线每件的外径在 112~118、内径在 44~48 之间随机，尺寸不一样，边缘对不齐。真正的污点只占环面中间那 121 个。")
        ]
    }

    Pitfall {
        text: qsTr("标准样差分对「位置、角度、尺寸、光照」的每一点不同都敏感。真实工件的尺寸本来就有公差，光是公差就会在每一件的边缘留下一圈「差异」。"
                 + "实际做法通常是：先对齐（平移、旋转，必要时缩放），再只在离边缘一定距离的区域里比较，或者对差异图再做一次形态学开运算，把细长的边缘残留去掉，只留成块的差异。")
    }

    Try {
        task: qsTr("如果只在环面中间（离两圈边缘都超过 8 像素）比较，这件待检件还剩多少差异像素？能不能判出它有污点？合格品之间比较呢？")
        answerNote: qsTr("按上面的分区统计，环面中间剩 121 个，几乎全是污点，判得出来。合格品之间比较，环面中间理论上只剩噪声和金属面上那块亮斑位置不同造成的差别——"
                       + "亮斑是跟着垫圈走的，对齐后应该基本重合，但无害的浅短纹每件都不一样，比 40 的阈值浅得多，大多不会超过阈值。本机把待检件换成合格品实测：环面中间 0 个，边缘附近照样有 3713 个。")
    }

    InSystem {
        text: qsTr("工位检测没有用标准样差分：模拟工件的尺寸有公差，表面缺陷用黑帽找更稳。数据由 examples/opencv/measure 测得。")
    }
}

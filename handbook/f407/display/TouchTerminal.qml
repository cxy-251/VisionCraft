import QtQuick
import VisionCraft

Section {
    title: qsTr("触屏终端与软键盘")
    lead: qsTr("把上一节的触摸读取写进固件，再在屏上画一个软键盘：手指按下的坐标落在哪个键上，就输入哪个字符。这是工位屏从「只显示」变成「能操作」的第一步。")

    Why {
        text: qsTr("工位上常要让操作员输入点东西：工号、批次号、复检原因。外接键盘不方便，屏幕本身就能触摸。"
                 + "「GT9147 电容触摸」一节用调试器读坐标，每秒只能读一次左右，只能用来摸清芯片；真正的终端要在固件里每 20 ms 读一次。"
                 + "这一节做成一个实验固件：在工位固件的副本上加 touchterm.c，替换掉原来的 StationTask（画工位界面的任务），其余任务（RTT 通信、环境采集）照旧。测完烧回原固件。")
    }

    CodeRef { file: "tools/fw_touchterm/touchterm.c"; region: "i2c" }
    CodeRef { file: "tools/fw_touchterm/touchterm.c"; region: "init" }

    KeyPoints {
        label: qsTr("触摸驱动")
        points: [
            qsTr("和调试器版本同一个思路，只是换成 C：PB0、PF11 配成开漏输出（HAL 的 GPIO_MODE_OUTPUT_OD），写 1 就是放开、由上拉拉高，读 SDA 直接读输入寄存器。每个半周期用 DWT 等约 3 µs，I2C 时钟约 100 kHz 量级。"),
            qsTr("启动时按「GT9147 电容触摸」一节摸出来的时序复位芯片：RST 拉低、INT 给高、松开 RST、INT 改回输入，再往 0x8040 写 2、写 0。少了这一步芯片不报告触摸，那一节已经实测过。"),
            qsTr("gt_point 读 0x814E：最高位为 0 表示没有新数据（返回 −1）；有新数据时低 4 位是手指个数，再读第一个点的坐标，最后写 0 让芯片放下一帧。")
        ]
    }

    CodeRef { file: "tools/fw_touchterm/touchterm.c"; region: "keyboard" }
    CodeRef { file: "tools/fw_touchterm/touchterm.c"; region: "task" }

    KeyPoints {
        label: qsTr("软键盘")
        points: [
            qsTr("4 行 × 10 个键，每个键 48 × 70 像素，从 y = 440 开始。触摸坐标和屏幕坐标是同一个方向（竖屏 480 × 800），所以「坐标落在哪个键」只是两次除法：行 = (y − 440) ÷ 70，列 = x ÷ 48。"),
            qsTr("只在「手指刚按下」的那一刻算一次按键：按着不放时芯片会一直报告同一个点，不加这个判断，按一下会输入一串相同的字符。手指抬起（触点数为 0）才允许下一次。"),
            qsTr("按下的键先涂成橙色、80 ms 后恢复，给操作员一个反馈。< 删除最后一个字符，_ 是空格，# 是确定：把输入框的内容移到 g_term_last，清空输入框。"),
            qsTr("这个任务是唯一画屏的任务（和工位固件一样，屏幕只由一个任务画），不会和别的任务抢屏。")
        ]
    }

    CodeRef { file: "handbook/f407/display/touchterm.txt"; caption: qsTr("烧录、在屏上打字、用调试器读回、烧回原固件") }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("在屏上依次按 A、3、空格、0、0、4、2、确定，再随便按几个字母和一次删除。按的人确认屏上的显示和按的一致；调试器读回 g_term_last = \"A3 0042\"，和按的完全一样，输入框里还留着「IIIOP」。"),
            qsTr("一共识别到 22 次按键。最后一次「按下」读到的坐标是 (65535, 65535)：它落在键盘范围外，没有被当成按键。这可能是某一帧读坐标时出了错，也可能是芯片在手指离开的瞬间报告了无效值，原因没有查。实用的驱动应该把超出 480 × 800 的坐标丢掉。"),
            qsTr("测完烧回原来的工位固件，校验通过，RTOS 节拍恢复每秒 1000 次。")
        ]
    }

    Pitfall {
        text: qsTr("触摸的读取频率决定了手感。这里每 20 ms 读一次（I2C 读写本身按位时序估算不到 1 ms，没有实测），对点按足够了；但如果要画手写轨迹，20 ms 一个点在快速划动时会连成折线。"
                 + "更好的做法是用 INT 脚：芯片有新数据时拉一下 INT，用外部中断通知任务去读，而不是定时轮询。本实验没有用 INT。")
    }

    Try {
        task: qsTr("如果去掉「只在手指刚按下时算一次」的判断（down 变量），按住「A」键 1 秒，会输入几个 A？")
        answerNote: qsTr("推测：任务每 20 ms 读一次，芯片在手指按着时持续报告新数据，1 秒大约 40–50 次读取（每次还要加 80 ms 的按键反馈延时，实际约 10 次左右），会输入一串 A，直到输入框满 18 个字符。本题没有改固件实测。")
    }

    InSystem {
        text: qsTr("工位固件还没有触摸功能，这一节是实验固件。要正式加入，需要在 station.ioc 里配好 PB0、PF11、PB1、PC13，把 touchterm.c 的驱动部分搬进 App/，在 StationTask 的循环里加上读触摸、处理按键，并决定输入的内容做什么用（比如作为操作员编号，随检测结果一起经 RTT 发给上位机）。")
    }
}

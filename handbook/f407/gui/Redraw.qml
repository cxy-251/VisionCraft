import QtQuick
import VisionCraft

Section {
    title: qsTr("重画的代价：局部刷新与写屏时序")
    lead: qsTr("界面卡不卡，取决于两个数相乘：一次要写多少个像素，写一个像素要多久。前者靠「只画变了的」，后者靠 FSMC 时序。两个都在这套界面上实测过。")

    Why {
        text: qsTr("STM32F407 没有足够的内存放一整屏：480 × 800 × 2 字节 = 750 KB，而片内 RAM 只有 192 KB。所以画面不在单片机里，而在屏幕控制器 NT35510 的显存里，每个像素都要经 FSMC 并口写过去。"
                 + "写过去的像素就留在那里，不用每帧重来。这决定了单片机界面的基本思路：没变的地方不要碰。")
    }

    KeyPoints {
        label: qsTr("写一个像素要多久")
        points: [
            qsTr("板子上用 DWT 周期计数器给换页计时（gui.c 的 show_current 前后各读一次）。首页整屏 518144 个像素用了 31.0 ms，平均每个像素约 60 ns。"),
            qsTr("最早用 CubeMX 默认的 FSMC 时序（地址建立 15、数据建立 60 个 HCLK），换一页要 242–353 ms。按参数算，每次写约 76 个 HCLK、约 450 ns，和当时按页面像素数折算的每像素约 430–470 ns 对得上。"),
            qsTr("「FSMC 时序与屏幕识别」测出写可以快得多、读不行，于是打开扩展模式，写时序改成 2/5（约 8 个 HCLK，约 48 ns），读保持 15/60。换页降到 31–45 ms，约快 8 倍。剩下的十几纳秒是 CPU 算字形、循环的开销。")
        ]
    }

    CodeRef { file: "handbook/f407/gui/board-test.txt"; from: "第 1 次"; to: "连续快速点"; caption: qsTr("板子上：每次换页整屏重画的时间") }

    KeyPoints {
        label: qsTr("一次要写多少像素")
        points: [
            qsTr("模拟器给每一步数了像素（「在电脑上运行界面代码」）。换页是整屏级别：首页 52 万，工位页 62 万，传感器页 82 万（两张曲线图各先填一遍底色）。"),
            qsTr("按下一个图标只写了 38784 个，是整屏的 7%：框架只重画了被按的那个控件（dirty 标记）。拖出去取消 77568 个，正好两次——按下变亮一次，取消恢复一次。"),
            qsTr("停在首页 130 秒写了 0 个像素：首页没有会变的内容，也就一个像素都不写，CPU 和总线都空着。")
        ]
    }

    CodeRef { file: "handbook/f407/gui/sim-before-cache.txt"; from: "==== 2"; to: "1 秒"; caption: qsTr("改之前：工位页什么都没变，1 秒也写了 18 万个像素") }

    Para {
        text: qsTr("工位页原来的 ui_update 每 250 ms 把所有动态文字（在线状态、收帧数、温度、光照、电压、按键、运行时间）全部重写一遍，不管变没变。"
                 + "1 秒 4 次，每次 45056 个像素，就是上面的 180224。按每像素 60 ns 算，大约每秒占 11 ms 的 CPU 和总线——不多，但全是白干。")
    }

    CodeRef { file: "firmware/station/App/station_ui.c"; region: "cache" }
    CodeRef { file: "examples/gui_sim/output.txt"; from: "==== 2"; to: "1 秒"; caption: qsTr("改之后") }

    KeyPoints {
        label: qsTr("字段缓存")
        points: [
            qsTr("每个动态字段记住上次画的文字和颜色，和这次一样就直接返回。ui_init（进入工位页、整页刚重画过）时清空缓存，保证下一次每个字段都画一遍。"),
            qsTr("改之后空闲 1 秒写 22528 个像素，降到八分之一。剩下的恰好是真的变了的三个字段：运行时间 8 个字（每字 16 × 32 = 512 像素，共 4096），模拟器里温度和光照每秒都变，各 8 个大字（每字 24 × 48，共 9216 × 2）。4096 + 18432 = 22528，一个不差。"),
            qsTr("所有截图和改之前逐字节相同：缓存只省掉了「用同样的内容覆盖同样的内容」。板子上实测，2 秒前后运行时间那一行的像素变了，说明真正变了的字段照样会画。")
        ]
    }

    CodeRef { file: "handbook/f407/gui/board-test.txt"; from: "字段缓存"; to: "有缓存之后"; caption: qsTr("板子上：加缓存后，界面测试照旧通过，运行时间照样刷新") }

    Pitfall {
        text: qsTr("缓存的前提是「屏上的内容只有我在改」。如果别的代码在缓存不知道的情况下盖掉了这块区域（比如换页时整屏填背景），缓存还以为字在那里，就不会再画，屏上那块就一直空着。"
                 + "这里在 ui_init 里清缓存，正是因为换页会整屏填色。以后加弹窗之类会临时盖住一部分的东西，弹窗关掉时也要让被盖住的字段作废。LVGL 用「无效区域」统一处理这件事：谁盖了哪块、哪块要重画，由库来记。")
    }

    Try {
        task: qsTr("设备页停 3 秒写了 204288 个像素（模拟器输出最后一步）。运行时间每秒才变一次，空闲堆和任务数几乎不变，钱花在哪了？怎么省？")
        answerNote: qsTr("看 page_device.c 的 row()：每次先用 lcd_fill 把整行值区域（432 × 32 = 13824 像素）填成背景，再写字。每秒刷新三行，每行填色加写字。"
                         + "可以照工位页的办法加缓存，只重画运行时间那一行；再进一步，写字时 lcd_text 本身就会画背景色，只要新字符串不比旧的短，就不需要先填整行。本题只做了分析，没有改代码实测。")
    }

    InSystem {
        text: qsTr("工位固件已经包含字段缓存和 FSMC 扩展模式。下一步换成 LVGL：它的做法是在 RAM 里开一小块绘图缓冲（比如屏幕的十分之一），只把「无效区域」画进缓冲再整块送到屏上——本节手工做的两件事，它都做成了通用机制。")
    }
}

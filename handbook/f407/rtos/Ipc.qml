import QtQuick
import VisionCraft

Section {
    title: qsTr("任务间通信")
    lead: qsTr("队列、任务通知、互斥锁、锁调度器、临界区，都能让任务之间安全地交接数据或协调动作。它们各花多少时间？在板子上量一遍，选的时候心里就有数了。")

    Why {
        text: qsTr("「工位固件的任务划分」讲了工位固件用到的三种办法和各自的场景。那一节回答「用哪个」，这一节回答「代价多大」。"
                 + "测量放在一个实验固件里：在工位固件的副本上加一个文件 ipc_bench.c，开两个最高优先级的测试任务，每种操作做 1000 次，用 DWT 周期计数器（168 MHz）计时，结果放在内存里，由调试器读出；测完烧回原来的固件。"
                 + "工位固件本身不变。")
    }

    CodeRef { file: "tools/fw_bench/ipc_bench.c"; region: "pingpong" }
    CodeRef { file: "tools/fw_bench/ipc_bench.c"; region: "local" }
    CodeRef { file: "tools/fw_bench/build_variant.sh"; from: "# app_init"; to: "CMakeLists.txt$"; caption: qsTr("实验固件 = 工位固件的副本 + 这个文件 + 两行改动") }
    CodeRef { file: "handbook/f407/rtos/ipc-bench.txt"; from: "每项"; to: "不切换"; caption: qsTr("在板子上的结果（Release 编译，-Os）") }

    KeyPoints {
        label: qsTr("读结果")
        points: [
            qsTr("队列来回一次 19.8 µs，任务通知来回一次 6.8 µs，快约 3 倍。两者都包含两次任务切换；队列多出来的时间，主要应该花在拷贝数据和维护等待列表上（这是推测，没有逐项拆开量）。"),
            qsTr("同一个任务里往队列放一个、取一个（不需要切换任务）要 2.3 µs；对照上面的来回 19.8 µs，大头是任务切换。"),
            qsTr("没有竞争的互斥锁，取加还 2.0 µs；锁住调度器再解开 0.77 µs；临界区进出一次只要 0.27 µs（45 个周期）。"),
            qsTr("两次运行的周期数完全相同：程序从复位开始，执行路径和中断到来的时刻都一样。")
        ]
    }

    KeyPoints {
        label: qsTr("怎么选")
        points: [
            qsTr("一对一、只传一个信号或一个 32 位数：任务通知最快，也不用创建任何对象。缺点是只能发给一个指定的任务。"),
            qsTr("传数据、可能多个发送者、需要缓冲：队列。工位固件的蜂鸣请求就是这种，每次 20 µs 左右，相对于每次蜂鸣几十到几百毫秒，可以忽略。"),
            qsTr("保护一段要花时间的共享资源（比如发送缓冲区：编码一帧再写进 RTT，比这里的几个操作都长得多）：互斥锁。它支持优先级继承，等待的任务会睡眠，不浪费 CPU。"),
            qsTr("只拷贝几个字节的结构体：锁调度器或临界区就够了。临界区最快，但它会屏蔽优先级 5–15 的中断（见「移植与中断优先级」），里面只能放几十个周期的事；锁调度器不挡中断，代价也很小。")
        ]
    }

    Pitfall {
        text: qsTr("这些数字是「什么都不干、只做这一件事」时的下限，而且两个测试任务优先级最高，测量时不会被工位固件的其他任务打断。"
                 + "实际程序里，如果等待的一方优先级更低、或者有别的任务也就绪，从「放进队列」到「对方开始处理」可能要等很久，那取决于调度，而不是队列本身的速度。"
                 + "另外 ipc_bench.c 里的测试任务栈只有 256 个字（1 KB），工位固件的堆里还剩足够的空间；如果堆不够，xTaskCreate 会失败而测量永远不结束——run_bench.tcl 里设了 10 秒超时，就是为了能看出这种情况。")
    }

    Try {
        task: qsTr("工位固件里 EnvTask 写传感器读数、StationTask 读，用的是 osKernelLock（锁调度器）。如果改成互斥锁，每次多花多少时间？值不值得改？")
        answerNote: qsTr("按本节的测量：锁调度器一来一回 0.77 µs，互斥锁 2.0 µs，每次多约 1.2 µs。传感器读数每秒只读写几次，这点差别完全无所谓；"
                       + "真正的区别在行为上：锁调度器期间所有任务都不会切换（但中断照常），适合「几个字节、立刻完成」的拷贝；互斥锁只挡住同样要这把锁的任务。这里拷贝的是一个小结构体，现在的写法是合适的。这是根据测量结果的分析，没有改固件去测。")
    }

    InSystem {
        text: qsTr("工位固件的实际用法（App/app.c）：蜂鸣请求走队列，发送缓冲区用互斥锁，最新检测结果和传感器读数用锁调度器。和本节的测量对照，这些开销都在微秒级，远小于 1 毫秒的系统节拍，不是性能瓶颈。")
    }
}

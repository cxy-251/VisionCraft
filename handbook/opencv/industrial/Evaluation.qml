import QtQuick
import VisionCraft

Section {
    title: qsTr("怎样评价一个检测算法")
    lead: qsTr("「准确率 99%」这句话本身说明不了什么。要分开看两种错误：把坏的放过去，和把好的拦下来。")

    Why {
        text: qsTr("工位上的检测算法会犯两种错：有缺陷的件判成合格，叫漏检，坏件会流到客户手里；"
                 + "合格的件判成不合格，叫误报，好件被白白扔掉或者要人工复检。两种错的代价完全不同，"
                 + "而且通常此消彼长：把阈值调严，漏检少了，误报就多了。只看一个总的准确率，就看不出算法到底错在哪边。")
    }

    Para {
        text: qsTr("办法是准备一批「标准答案已知」的样本，跑一遍算法，把结果填进一张表：行是真实情况，列是算法的判定。"
                 + "这张表叫混淆矩阵。对角线上是判对的，其他格子都是判错的，而且能看出错成了什么。"
                 + "本项目的工件是程序生成的，每件的缺陷是程序自己加的，天然带标准答案。")
    }

    Demo {
        title: qsTr("混淆矩阵")
        EvalView { }
        Para {
            font.pixelSize: Theme.fontSmall
            color: Theme.textMuted
            text: qsTr("固定随机种子，同样的参数每次结果一样。先用默认值跑一遍，再把「表面阈值」拉到 14 和 30 各跑一遍，对比漏检率和误报率。")
        }
    }

    Para {
        text: qsTr("下面是在缺陷难度 0.8（接近阈值）时，每类 120 件、只改表面阈值的扫描结果。这组数字由测试 tst_inspector 实际跑出：")
    }

    KeyPoints {
        label: qsTr("表面阈值扫描（难度 0.8）")
        points: [
            qsTr("阈值 14：漏检 0.6%，误报 13.3%。几乎不放过坏件，但每 8 件好件就有 1 件被拦下——工件表面那些无害的浅纹也被当成了缺陷。"),
            qsTr("阈值 17：漏检 0.8%，误报 2.5%。"),
            qsTr("阈值 18（默认值）：漏检 2.5%，误报 1.7%。"),
            qsTr("阈值 19：漏检 7.3%，误报 0%。"),
            qsTr("阈值 40（最初拍脑袋定的值）：漏检 25.6%，误报 0%。看起来「从不误报」，实际上四分之一的坏件被放过去了。")
        ]
    }

    CodeRef { file: "tests/tst_inspector.cpp"; region: "sweep"; caption: qsTr("扫描的统计口径") }

    Para {
        text: qsTr("阈值卡在哪里，取决于两种错误各自的代价：放过一个坏件要赔偿、召回，就往严里调，接受更多误报；"
                 + "好件贵、坏件影响小，就往松里调。这是业务决定，不是算法能替你决定的。算法能做的是把这条曲线变得更好——"
                 + "让同样的误报率下漏检更少。")
    }

    Para { text: qsTr("被阈值卡住的是表面检测这一步：黑帽变换把「比周围暗的小东西」提出来，超过阈值的才算异常，再按形状分划痕和污点。") }
    CodeRef { file: "src/vision/Inspector.cpp"; region: "surface" }

    Pitfall {
        text: qsTr("测试样本太「干净」，评估结果就会骗人。最初生成的合格品表面完美无瑕，阈值调到多低都不会误报，"
                 + "于是看不出 40 这个阈值其实太松。给合格品加上真实工件也会有的浅加工纹之后，误报才出现，阈值的取舍才有意义。"
                 + "评估用的样本要尽量像生产现场：好件该有的瑕疵要有，坏件要有轻有重。")
    }

    Pitfall {
        text: qsTr("不要只报一个准确率。五类各 120 件时，哪怕划痕全部漏检，总准确率也还有 80%。"
                 + "要分类别看，至少分开报漏检率和误报率。")
    }

    Try {
        task: qsTr("在演示里把难度拉到 1.0，你会看到划痕大量被判成合格。只调表面阈值能救回来吗？救回来的代价是什么？"
                 + "如果不能，问题出在流程的哪一步？")
        answerNote: qsTr("难度 1.0 时划痕只有 1 像素宽、颜色很浅，经过 5×5 高斯模糊之后对比度所剩无几。"
                       + "把阈值降到能抓住它的程度，合格品上的浅纹也会大量触发，误报暴涨。"
                       + "根本原因在模糊这一步抹掉了细线：可以换成更小的模糊核，或者专门用对细长结构敏感的方法（例如方向滤波）检测划痕。")
    }

    InSystem {
        text: qsTr("「工位」页右下角的混淆矩阵就是这一节的实时版：产线每检测一件，按标准答案记一格。"
                 + "检测算法和这里的演示是同一个 Inspector 类。")
    }
}
